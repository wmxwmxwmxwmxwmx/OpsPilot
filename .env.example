LLM_MODE=mock
MAX_STEPS=6
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10

# Set all three values before using LLM_MODE=openai.
# Base URL is the API root (including /v1 if required), not /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional short-lived conversation history; stateless APIs never access Redis.
SESSION_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=10
SESSION_MAX_MESSAGE_CHARS=16000
SESSION_MAX_BYTES=262144

# Optional durable completed diagnosis records; independent from Redis Session.
INCIDENT_PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://opspilot:password@127.0.0.1:5432/opspilot
# Separate DDL configuration: only Alembic reads this; the app never auto-migrates.
MIGRATION_DATABASE_URL=postgresql+asyncpg://opspilot:password@127.0.0.1:5432/opspilot
