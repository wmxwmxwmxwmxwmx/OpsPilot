LLM_MODE=mock
MAX_STEPS=6
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10

# V0.3: legacy APIs always retain their behavior. langgraph enables /workflows.
AGENT_ENGINE=legacy
WORKFLOW_ENABLED=false
# All workflow routes are local-demo-only and require this shared bearer token.
WORKFLOW_LOCAL_DEMO=false
WORKFLOW_API_TOKEN=
# Psycopg URL (NOT postgresql+asyncpg). Run explicit checkpoint setup before use.
CHECKPOINT_DATABASE_URL=postgresql://opspilot:password@127.0.0.1:5432/opspilot
WORKFLOW_RETENTION_DAYS=7

# Set all three values before using LLM_MODE=openai.
# Base URL is the API root (including /v1 if required), not /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional short-lived conversation history; stateless APIs never access Redis.
SESSION_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=10
SESSION_MAX_MESSAGE_CHARS=16000
SESSION_MAX_BYTES=262144

# Optional durable completed diagnosis records; independent from Redis Session.
INCIDENT_PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://opspilot:password@127.0.0.1:5432/opspilot
# Separate DDL configuration: only Alembic reads this; the app never auto-migrates.
MIGRATION_DATABASE_URL=postgresql+asyncpg://opspilot:password@127.0.0.1:5432/opspilot

# Optional read cache for safe historical Incident summaries; requires persistence.
# Reuses REDIS_URL and its application-level client, independently of SESSION_ENABLED.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=opspilot:cache
CACHE_MAX_BYTES=65536
# Per-cache-operation deadline, in addition to the shared Redis socket timeouts.
CACHE_IO_TIMEOUT_SECONDS=0.5
